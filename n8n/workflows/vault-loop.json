{
  "name": "vault-loop",
  "nodes": [
    {
      "id": "vl-01",
      "name": "Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Every trigger's job arrives here as { kind, source, ref, detail }.\n// Normalise it and give it the dedupe key.\nreturn $input.all().map((item) => {\n  const j = item.json;\n  const ref = String(j.ref || '').trim();\n  return { json: { kind: j.kind, source: j.source, ref, detail: String(j.detail || ''), job_key: j.kind + ':' + ref } };\n});\n"
      }
    },
    {
      "id": "vl-02",
      "name": "Find open job",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "loop_jobs"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "job_key",
              "condition": "eq",
              "keyValue": "={{ $json.job_key }}"
            },
            {
              "keyName": "status",
              "condition": "neq",
              "keyValue": "done"
            },
            {
              "keyName": "status",
              "condition": "neq",
              "keyValue": "failed"
            }
          ]
        },
        "returnAll": true
      },
      "alwaysOutputData": true
    },
    {
      "id": "vl-03",
      "name": "Only new jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Drop jobs that already have a queued or running row with the same key.\nconst open = new Set($input.all().filter((i) => i.json.id).map((i) => i.json.job_key));\nconst seen = new Set();\nconst out = [];\nfor (const item of $('Job').all()) {\n  const j = item.json;\n  if (open.has(j.job_key) || seen.has(j.job_key)) continue;\n  seen.add(j.job_key);\n  out.push({ json: { ...j, status: 'queued', attempts: 0 } });\n}\nreturn out;\n"
      }
    },
