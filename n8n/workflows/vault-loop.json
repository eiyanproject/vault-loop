    {
      "id": "vl-17",
      "name": "Syncthing: settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        880
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Filled in by n8n/setup-n8n.sh (SYNCTHING_URL, SYNCTHING_FOLDER). Re-run\n// setup to change them rather than editing here: setup overwrites this node.\nconst SYNCTHING_URL = '__SYNCTHING_URL__';\nconst FOLDER_ID = '__SYNCTHING_FOLDER__';\nconst s = $getWorkflowStaticData('global');\nreturn [{ json: { url: SYNCTHING_URL, folder: FOLDER_ID, since: s.syncthingLastEvent || 0 } }];\n"
      }
    },
    {
      "id": "vl-18",
      "name": "Syncthing events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        880
      ],
      "parameters": {
        "url": "={{ $json.url }}/rest/events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $json.since }}"
            },
            {
              "name": "events",
              "value": "ItemFinished,FolderSummary"
            },
            {
              "name": "timeout",
              "value": "1"
            }
          ]
        },
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__SYNCTHING_CRED_ID__",
          "name": "Syncthing CT 107"
        }
      }
    },
    {
      "id": "vl-19",
      "name": "Syncthing: notes after idle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        880
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Collect notes CT 107 received, and queue them only once the folder is idle\n// again: one job per note per sync, never a half-written file.\nconst s = $getWorkflowStaticData('global');\nconst cfg = $('Syncthing: settings').first().json;\nlet events = $input.all().map((i) => i.json);\nif (events.length === 1 && Array.isArray(events[0])) events = events[0];\nif (events.length === 1 && Array.isArray(events[0].data)) events = events[0].data;\ns.pending = s.pending || {};\nlet idle = false;\nfor (const e of events) {\n  if (typeof e.id === 'number' && e.id > (s.syncthingLastEvent || 0)) s.syncthingLastEvent = e.id;\n  const d = e.data || {};\n  if (d.folder !== cfg.folder) continue;\n  if (e.type === 'ItemFinished' && !d.error && d.type === 'file' && /\\.md$/i.test(d.item || '')) {\n    if (d.action === 'delete') delete s.pending[d.item]; else s.pending[d.item] = true;\n  }\n  if (e.type === 'FolderSummary' && d.summary && d.summary.state === 'idle' && !d.summary.needTotalItems) idle = true;\n}\nif (!idle) return [];\nconst notes = Object.keys(s.pending).filter((p) => !p.startsWith('.') && !p.startsWith('_agent/'));\ns.pending = {};\nreturn notes.map((ref) => ({ json: { kind: 'triage', source: 'syncthing', ref, detail: 'synced to CT 107' } }));\n"
      }
    },
