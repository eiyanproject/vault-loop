      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        1100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const row = $input.all().map((i) => i.json).find((j) => j.id);\nif (!row) return [{ json: { job: null, id: -1, attempts: 0 } }];\nconst job = { id: row.id, kind: row.kind, source: row.source, ref: row.ref, detail: row.detail, attempts: (row.attempts || 0) + 1 };\nreturn [{ json: { job, id: row.id, attempts: job.attempts } }];\n"
      }
    },
