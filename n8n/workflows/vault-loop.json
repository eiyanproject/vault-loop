        "mode": "runOnceForAllItems",
        "jsCode": "// Safety net for missed events or a PC that was asleep. Dedupe in the queue\n// chain means this never stacks up more than one scan-inbox job.\nreturn [{ json: { kind: 'scan-inbox', source: 'sweep', ref: 'Inbox', detail: '15-minute sweep' } }];\n"
      }
