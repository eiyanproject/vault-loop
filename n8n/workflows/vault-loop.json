    {
      "id": "vl-14",
      "name": "Stuck for over 2 hours",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        680
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// A job a worker claimed but never reported on. Mark it failed so it shows\n// up for Run now's retry instead of blocking its key forever.\nconst cutoff = Date.now() - 2 * 60 * 60 * 1000;\nreturn $input.all()\n  .filter((i) => i.json.id && new Date(i.json.updatedAt).getTime() < cutoff)\n  .map((i) => ({ json: { id: i.json.id } }));\n"
      }
    },
