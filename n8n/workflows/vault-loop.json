    {
      "id": "vl-05",
      "name": "Plane webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        100
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "vault-loop/plane",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "6b0c3f9e-1d1a-4c55-9a51-0f3b7a2d1001"
    },
    {
      "id": "vl-06",
      "name": "Plane: approved items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Plane sends every work item event. Keep only items whose state is\n// \"Approved\" (by name). If the payload carries no state name, queue a\n// plane-item job anyway and let the worker read the item from Plane's API:\n// a missed approval costs more than an extra check.\nconst out = [];\nfor (const item of $input.all()) {\n  const body = item.json.body || item.json;\n  if (body.event !== 'issue' && body.event !== 'work_item') continue;\n  if (body.action === 'deleted') continue;\n  const d = body.data || {};\n  const stateName = (d.state && d.state.name) || (d.state_detail && d.state_detail.name) || d.state__name || '';\n  if (stateName && stateName.toLowerCase() !== 'approved') continue;\n  if (!d.id) continue;\n  out.push({ json: {\n    kind: 'plane-item', source: 'plane', ref: d.id,\n    detail: stateName ? 'moved to Approved' : 'state not in payload; worker checks it',\n  } });\n}\nreturn out;\n"
      }
    },
    {
      "id": "vl-07",
      "name": "Run now",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "formTitle": "Vault loop: run now",
        "formDescription": "Queue work for the PC worker now instead of waiting for the next sync or sweep.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Action",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Scan Inbox"
                  },
                  {
                    "option": "Process one note"
                  },
                  {
                    "option": "Retry a failed job"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Note path or job id",
              "placeholder": "Inbox/my-note.md  or  42"
            }
          ]
        },
        "options": {
          "path": "vault-loop/run-now",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Queued. The PC worker picks it up on its next poll."
            }
          }
        }
      },
      "webhookId": "6b0c3f9e-1d1a-4c55-9a51-0f3b7a2d1002"
    },
    {
      "id": "vl-08",
      "name": "Run now: route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const f = $input.first().json;\nconst action = f['Action'];\nconst arg = String(f['Note path or job id'] || '').trim();\nif (action === 'Retry a failed job') {\n  if (!/^\\d+$/.test(arg)) throw new Error('Retry needs a job id (a number), got: ' + arg);\n  return [{ json: { retry_id: Number(arg) } }];\n}\nif (action === 'Process one note') {\n  if (!arg.endsWith('.md')) throw new Error('Process one note needs a vault path ending in .md, got: ' + arg);\n  return [{ json: { kind: 'triage', source: 'run-now', ref: arg.replace(/^\\/+/, ''), detail: 'Run now' } }];\n}\nreturn [{ json: { kind: 'scan-inbox', source: 'run-now', ref: 'Inbox', detail: 'Run now' } }];\n"
      }
    },
    {
      "id": "vl-09",
      "name": "Is retry?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        640,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r1",
                    "leftValue": "={{ $json.retry_id }}",
                    "rightValue": "",
                    "operator": {
                      "type": "number",
                      "operation": "exists",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "retry"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "new job"
        }
      }
    },
